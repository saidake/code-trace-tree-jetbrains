<idea-plugin>
    <id>com.pidifa.codetracetree</id>
    <name>Code Trace Tree</name>
    <vendor>pidifa</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Code Trace Tree"
                anchor="right"
                factoryClass="com.pidifa.codetracetree.toolWindow.MyToolWindowFactory"
                secondary="false"
                icon="/icons/code_trace_tree_icon.svg"
                icon-dark="/icons/code_trace_tree_icon_dark.svg"
                canCloseContent="false"
                sideTool="false"
        />
        <projectService serviceImplementation="com.pidifa.codetracetree.services.TracePointService"/>
        <postStartupActivity implementation="com.pidifa.codetracetree.CodeTraceTreeProjectActivity"/>
        <notificationGroup id="Code Trace Tree" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="com.pidifa.codetracetree.CreateRootTracePointAction"
                class="com.pidifa.codetracetree.actions.CreateRootTracePointAction"
                text="Create a Root Trace Point"
                description="Creates a root-level trace point at the current line">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="com.pidifa.codetracetree.CreateTracePointUnderSelectedAction"
                class="com.pidifa.codetracetree.actions.CreateTracePointUnderSelectedAction"
                text="Create a Trace Point (Under Selected)"
                description="Adds the current line as a child of every selected trace point">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="com.pidifa.codetracetree.UpdateTracePointAction"
                class="com.pidifa.codetracetree.actions.UpdateTracePointAction"
                text="Update the selected code trace point"
                description="Updates the selected code trace point(s) to the current line">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="com.pidifa.codetracetree.GoToTracePointInTreeAction"
                class="com.pidifa.codetracetree.actions.GoToTracePointInTreeAction"
                text="Go to the Trace Point in the tree panel (Only matching)"
                description="Selects matching trace point(s) for the current line in the Code Trace Tree tool window; does nothing when none match">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="com.pidifa.codetracetree.CreateRootPathTracePointAction"
                class="com.pidifa.codetracetree.actions.CreateRootPathTracePointAction"
                text="Create a Root Trace Point"
                description="Creates a root-level file or directory trace point from the Project View">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <action id="com.pidifa.codetracetree.CreatePathTracePointUnderSelectedAction"
                class="com.pidifa.codetracetree.actions.CreatePathTracePointUnderSelectedAction"
                text="Create a Trace Point (Under Selected)"
                description="Adds the selected file or directory as a child of every selected trace point">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
