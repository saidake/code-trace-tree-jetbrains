<idea-plugin>
    <id>com.simi.labs.codetracetree</id>
    <name>Code Trace Tree</name>
    <vendor>saidake</vendor>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Code Trace Tree"
                anchor="right"
                factoryClass="com.simi.labs.codetracetree.toolWindow.MyToolWindowFactory"
                secondary="false"
                icon="/icons/code_trace_tree_icon.svg"
                icon-dark="/icons/code_trace_tree_icon_dark.svg"
                canCloseContent="false"
                sideTool="false"
        />
        <postStartupActivity implementation="com.simi.labs.codetracetree.startup.MyProjectActivity" />
        <projectService serviceImplementation="com.simi.labs.codetracetree.services.TracePointService"/>
    </extensions>

    <actions>
        <action id="com.simi.labs.codetracetree.CreateTracePointAction"
                class="com.simi.labs.codetracetree.actions.CreateTracePointAction"
                text="Create a code trace point"
                description="Creates a code trace point at the current line">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="com.simi.labs.codetracetree.UpdateTracePointAction"
                class="com.simi.labs.codetracetree.actions.UpdateTracePointAction"
                text="Update the selected code trace point"
                description="Updates the selected code trace point(s) to the current line">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>