<!-- Plugin Configuration File -->
<idea-plugin>
    <id>com.simi.labs.workflowtrace</id>
    <name>workflow-trace</name>
    <vendor>saidake</vendor>

    ів

    System: <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="WorkflowTrace"
                anchor="right"
                factoryClass="com.simi.labs.workflowtrace.toolWindow.MyToolWindowFactory"
                secondary="false"
                icon="/icons/workflow_trace_icon.svg"
                icon-dark="/icons/workflow_trace_icon_dark.svg"
                canCloseContent="false"
                sideTool="false"
        />
        <postStartupActivity implementation="com.simi.labs.workflowtrace.startup.MyProjectActivity" />
        <projectService serviceImplementation="com.simi.labs.workflowtrace.services.TracePointService"/>
    </extensions>

    <actions>
        <action id="com.simi.labs.workflowtrace.CreateTracePointAction"
                class="com.simi.labs.workflowtrace.actions.CreateTracePointAction"
                text="Create a workflow trace point"
                description="Creates a workflow trace point at the current line">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="com.simi.labs.workflowtrace.UpdateTracePointAction"
                class="com.simi.labs.workflowtrace.actions.UpdateTracePointAction"
                text="Update the selected workflow trace point"
                description="Updates the selected workflow trace point(s) to the current line">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>